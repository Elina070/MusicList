            <staticText><reportElement mode="Opaque" x="0" y="0" width="25" height="40" backcolor="#E2E2E2"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="8"/></textElement><text><![CDATA[№]]></text></staticText>
