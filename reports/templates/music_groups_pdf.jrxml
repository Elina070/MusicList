            <textField isStretchWithOverflow="true"><reportElement x="65" y="0" width="110" height="34"/><box><pen lineWidth="0.5"/></box><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{name}]]></textFieldExpression></textField>
