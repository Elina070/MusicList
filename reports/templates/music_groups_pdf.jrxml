              name="MusicGroupsPDF" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="35" bottomMargin="35"
              whenNoDataType="AllSectionsNoDetail" uuid="8f9e5a31-6df4-4a19-9d50-000000000701">
    <queryString language="xPath"><![CDATA[/musicGroups/group]]></queryString>
    <field name="icon" class="java.lang.String"><fieldDescription><![CDATA[@icon]]></fieldDescription></field>
