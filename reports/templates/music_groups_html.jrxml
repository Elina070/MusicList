            <textField><reportElement x="180" y="39" width="310" height="18"/><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{icon} == null || $F{icon}.length() == 0 ? "—" : $F{icon}]]></textFieldExpression></textField>

